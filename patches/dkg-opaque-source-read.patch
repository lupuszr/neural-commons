--- a/packages/core/test/imported-artifact-metadata.test.ts
+++ b/packages/core/test/imported-artifact-metadata.test.ts
@@ -97,3 +97,14 @@ describe('imported artifact metadata resolver', () => {
     });
   });
 });
+
+// Neural Commons opaque source compatibility: no extraction is needed to read original bytes.
+it('allows skipped source reads only when explicitly requested; never admits failed extraction', async () => {
+  for (const status of ['skipped', 'failed', 'processing']) {
+    const query = async (sparql: string) => ({bindings: sparql.includes('/_meta') ? [{fileHash: sourceHash, contentType:'application/octet-stream', extractionStatus:status}] : []});
+    await expect(resolveImportedArtifactMetadata({contextGraphId,assertionUri,query})).rejects.toThrow();
+    const read = resolveImportedArtifactMetadata({contextGraphId,assertionUri,query,allowSkippedSource:true});
+    if (status === 'skipped') await expect(read).resolves.toMatchObject({extractionStatus:'skipped',sourceFileHash:sourceHash});
+    else await expect(read).rejects.toThrow();
+  }
+});
